{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "homebrew": {
    "enabled": false
  },
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["Formula/rite.rb"],
      "matchStrings": ["version \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "rite",
      "packageNameTemplate": "rite-ly/rite",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.+)$",
      "autoReplaceStringTemplate": "version \"{{{newValue}}}\""
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": ["rite-ly/rite"],
      "postUpgradeTasks": {
        "commands": ["scripts/update-formula.sh {{{newVersion}}}"],
        "fileFilters": ["Formula/**"],
        "executionMode": "update"
      }
    }
  ]
}
